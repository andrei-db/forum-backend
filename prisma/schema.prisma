generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}
enum ForumType {
  discussion
  redirect
}
model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("text-neutral-300")
  description String?
  isDefault   Boolean  @default(false)
  isStaff     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  profilePicture String   @default("")
  online         Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastSeen       DateTime @default(now())

  groupId String?
  group   Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  topics   Topic[]
  posts    Post[]
  sessions Session[]

  @@index([username])
  @@index([email])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  forums Forum[]
}

model Forum {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  type        ForumType @default(discussion)
  redirectUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  topics Topic[]

  @@index([categoryId])
}
model Topic {
  id        String   @id @default(uuid())
  title     String
  sticky    Boolean  @default(false)
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forumId String
  forum   Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postsCount  Int     @default(0)
  firstPostId String? @unique
  lastPostId String? @unique

  posts Post[]

  firstPost Post? @relation("TopicFirstPost", fields: [firstPostId], references: [id], onDelete: SetNull)
  lastPost  Post? @relation("TopicLastPost", fields: [lastPostId], references: [id], onDelete: SetNull)

  @@index([forumId])
  @@index([authorId])
  @@index([createdAt])
  @@index([firstPostId])
  @@index([lastPostId])
}
model Post {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topicId String
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  firstForTopic Topic? @relation("TopicFirstPost")
  lastForTopic  Topic? @relation("TopicLastPost")

  @@index([topicId])
  @@index([authorId])
  @@index([createdAt])
}
model Session {
  id         String   @id @default(uuid())
  sessionId  String   @unique
  ip         String?
  userAgent  String?
  location   String?
  lastActive DateTime @default(now())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}